{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "benduffey",
  "main": "src/index.js",
  "compatibility_date": "2026-05-10",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 15, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "4167b63872fc4877b43171e78f8b9087"
    }
  ]
}
